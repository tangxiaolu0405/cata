{
  "brain": {
    "dir": "",
    "base_dir": ""
  },
  "llm": {
    "provider": "deepseek",
    "api_format": "openai",
    "api_key": "",
    "api_url": "https://api.deepseek.com/chat/completions",
    "model": "deepseek-v4-flash",
    "models": null,
    "max_tokens": 8192,
    "timeout": 600,
    "context_window": 1000000,
    "thinking": "auto",
    "enabled": true
  },
  "llm_previous_qwen": {
    "_comment": "原千问/DashScope 配置备份（JSON 无注释，用此对象保留）。恢复时复制字段到 llm。",
    "provider": "qwen",
    "api_url": "https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions",
    "model": "qwen-turbo"
  },
  "server": {
    "socket_path": "",
    "log_level": "info",
    "timezone": "Asia/Shanghai"
  },
  "evolution": {
    "enabled": true,
    "cycle_interval": 300,
    "context_compress_ratio": 0.85,
    "session_compress_turns": 12,
    "decision_max_tokens": 4096
  },
  "evolution_config_help": {
    "_comment": "evolution.decision_max_tokens：自主演进 LLM 决策 JSON 的 max_tokens。省略或 0=不限制（由模型/API 默认输出上限）；正整数=限制生成长度。JSON 被截断时可设为 4096–8192。可通过 cata config set evolution.decision_max_tokens 4096 修改。"
  },
  "exec": {
    "enabled": true,
    "require_confirm": false,
    "whitelist": ["*"],
    "blacklist": ["rm -rf /", "mkfs", "dd if=/dev/", ">/dev/sd", "| sh", "|bash", "powershell -e"],
    "max_output_bytes": 262144,
    "timeout_seconds": 120,
    "working_dir": ""
  },
  "workspace_files": {
    "enabled": true,
    "max_read_bytes": 524288,
    "max_write_bytes": 524288
  },
  "subagent": {
    "max_concurrent": 4,
    "default_max_rounds": 8,
    "max_tool_result_bytes": 8192,
    "default_tools": null
  },
  "subagent_default_tools_help": {
    "_comment": "省略或 null=worker 可用全套工具；设为逗号列表则 delegate_task 未指定 tools 时默认白名单。例：read_file,list_files,read_skill,run_command,run_skill,search_replace,append_file,create_file（不含 browser_*）"
  },
  "mcp": {
    "enabled": true,
    "servers": [
      {
        "name": "browser",
        "enabled": true,
        "command": "npx",
        "args": ["-y", "@playwright/mcp@0.0.75"],
        "env": null
      }
    ],
    "tool_timeout_seconds": 300,
    "max_output_bytes": 26214400
  },
  "mcp_browser_extension_example": {
    "_comment": "小红书创作平台等需已登录 Chrome：安装 Playwright MCP Bridge 扩展后，把 mcp.servers[browser].args 改为下方 args。详见 docs/mcp-browser.md",
    "args": ["-y", "@playwright/mcp@0.0.75", "--extension"]
  }
}
